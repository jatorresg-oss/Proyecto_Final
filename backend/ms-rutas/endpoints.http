### ms-rutas · Rutas y programación - pruebas manuales

@auth = http://127.0.0.1:8001
@host = http://127.0.0.1:8004

### Obtener token (ms-auth)
# @name login
POST {{auth}}/login
Content-Type: application/json

{
  "usuario": "admin",
  "password": "admin123"
}

@token = {{login.response.body.token}}

### Estado del servicio (público)
GET {{host}}/health

### Listado general (requiere token)
GET {{host}}/rutas
Authorization: Bearer {{token}}

### Sin token -> 401
GET {{host}}/rutas

### Buscar por ciudad (origen o destino, coincidencia parcial)
GET {{host}}/rutas/buscar?ciudad=Bogot
Authorization: Bearer {{token}}

### Buscar por origen
GET {{host}}/rutas/buscar?origen=Medell
Authorization: Bearer {{token}}

### Buscar por destino
GET {{host}}/rutas/buscar?destino=Cali
Authorization: Bearer {{token}}

### Buscar por tiempo estimado
GET {{host}}/rutas/buscar?tiempo=horas
Authorization: Bearer {{token}}

### Alias por ciudad
GET {{host}}/rutas/ciudad/Medell
Authorization: Bearer {{token}}

### Consultar tiempos estimados
GET {{host}}/rutas/tiempos
Authorization: Bearer {{token}}

### Consultar por id
GET {{host}}/rutas/1
Authorization: Bearer {{token}}

### Crear ruta -> 201
# @name crear
POST {{host}}/rutas
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "ciudad_origen": "Bogotá",
  "ciudad_destino": "Bucaramanga",
  "distancia": 390.50,
  "tiempo_estimado": "7 horas",
  "observaciones": "Ruta de prueba"
}

@nuevoId = {{crear.response.body.id}}

### Ruta duplicada (origen + destino, ignorando mayúsculas) -> 409
POST {{host}}/rutas
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "ciudad_origen": "bogotá",
  "ciudad_destino": "bucaramanga",
  "distancia": 400,
  "tiempo_estimado": "8 horas"
}

### Distancia en 0 -> 422
POST {{host}}/rutas
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "ciudad_origen": "Cali",
  "ciudad_destino": "Popayán",
  "distancia": 0,
  "tiempo_estimado": "2 horas"
}

### Ciudad origen repetida con destino distinto -> 201 (no es duplicado)
# @name otro
POST {{host}}/rutas
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "ciudad_origen": "Bogotá",
  "ciudad_destino": "Villavicencio",
  "distancia": 110,
  "tiempo_estimado": "2 horas"
}

@otroId = {{otro.response.body.id}}

### Editar ruta (PUT)
PUT {{host}}/rutas/{{nuevoId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "ciudad_origen": "Bogotá",
  "ciudad_destino": "Bucaramanga",
  "distancia": 395.75,
  "tiempo_estimado": "7 horas 30 minutos",
  "observaciones": "Ruta actualizada"
}

### Editar solo las observaciones (PATCH)
PATCH {{host}}/rutas/{{nuevoId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "observaciones": "Sin novedades"
}

### Distancia negativa al editar -> 422
PATCH {{host}}/rutas/{{nuevoId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "distancia": -1
}

### Cambiar el destino a uno ya usado -> 409
PATCH {{host}}/rutas/{{otroId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "ciudad_destino": "Bucaramanga"
}

### Eliminar rutas de prueba
DELETE {{host}}/rutas/{{nuevoId}}
Authorization: Bearer {{token}}

DELETE {{host}}/rutas/{{otroId}}
Authorization: Bearer {{token}}

### Eliminar ruta con programaciones -> 409
DELETE {{host}}/rutas/1
Authorization: Bearer {{token}}

### Id inexistente -> 404
GET {{host}}/rutas/9999
Authorization: Bearer {{token}}

### ---------------------------------------------------------------------------
### Programación de viajes (Día 10)
### Ajustar las fechas si se ejecuta este archivo en otro día.
### Contrato completo: docs/contrato-programacion.md en la raíz del repositorio.
### ---------------------------------------------------------------------------

@fecha = 2026-11-28
@llegada = 2026-11-29
@reprograma = 2026-11-30
@llegadaReprograma = 2026-12-01

### Listado general de programaciones -> 200
GET {{host}}/programaciones
Authorization: Bearer {{token}}

### Listado filtrado (conductor + fecha) -> 200
GET {{host}}/programaciones?conductor_id=1&fecha=2026-11-20
Authorization: Bearer {{token}}

### Todos los filtros a la vez -> 200
GET {{host}}/programaciones?conductor_id=1&vehiculo_id=1&ruta_id=1&estado=programado&fecha=2026-11-20
Authorization: Bearer {{token}}

### Detalle de una programación -> 200
GET {{host}}/programaciones/1
Authorization: Bearer {{token}}

### Detalle inexistente -> 404
GET {{host}}/programaciones/9999
Authorization: Bearer {{token}}

### Programar viaje -> 201 (siempre nace "programado")
# @name crearProgramacion
POST {{host}}/programaciones
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "conductor_id": 1,
  "vehiculo_id": 1,
  "ruta_id": 1,
  "fecha_salida": "{{fecha}}",
  "hora_salida": "06:00",
  "fecha_estimada_llegada": "{{llegada}}",
  "observaciones": "Salida desde el centro de carga"
}

@nuevaProgramacion = {{crearProgramacion.response.body.id}}

### Ver la programación recién creada -> 200
GET {{host}}/programaciones/{{nuevaProgramacion}}
Authorization: Bearer {{token}}

### Mismo conductor y vehículo en la misma fecha -> 409
POST {{host}}/programaciones
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "conductor_id": 1,
  "vehiculo_id": 1,
  "ruta_id": 1,
  "fecha_salida": "{{fecha}}",
  "hora_salida": "08:00",
  "fecha_estimada_llegada": "{{llegada}}"
}

### Conductor inactivo (id 3) -> 409
POST {{host}}/programaciones
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "conductor_id": 3,
  "vehiculo_id": 1,
  "ruta_id": 1,
  "fecha_salida": "{{fecha}}",
  "hora_salida": "08:00",
  "fecha_estimada_llegada": "{{llegada}}"
}

### Vehículo en mantenimiento (id 3) -> 409
POST {{host}}/programaciones
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "conductor_id": 2,
  "vehiculo_id": 3,
  "ruta_id": 1,
  "fecha_salida": "{{fecha}}",
  "hora_salida": "08:00",
  "fecha_estimada_llegada": "{{llegada}}"
}

### Referencia inexistente -> 422
POST {{host}}/programaciones
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "conductor_id": 9999,
  "vehiculo_id": 1,
  "ruta_id": 1,
  "fecha_salida": "{{fecha}}",
  "hora_salida": "08:00",
  "fecha_estimada_llegada": "{{llegada}}"
}

### Fecha de salida en el pasado -> 422
POST {{host}}/programaciones
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "conductor_id": 1,
  "vehiculo_id": 1,
  "ruta_id": 1,
  "fecha_salida": "2026-11-26",
  "hora_salida": "08:00",
  "fecha_estimada_llegada": "{{llegada}}"
}

### Llegada anterior a la salida -> 422
POST {{host}}/programaciones
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "conductor_id": 1,
  "vehiculo_id": 1,
  "ruta_id": 1,
  "fecha_salida": "{{fecha}}",
  "hora_salida": "08:00",
  "fecha_estimada_llegada": "2026-11-27"
}

### Hora inválida -> 422
POST {{host}}/programaciones
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "conductor_id": 1,
  "vehiculo_id": 1,
  "ruta_id": 1,
  "fecha_salida": "{{fecha}}",
  "hora_salida": "25:00",
  "fecha_estimada_llegada": "{{llegada}}"
}

### Campos obligatorios ausentes -> 422
POST {{host}}/programaciones
Authorization: Bearer {{token}}
Content-Type: application/json

{ "conductor_id": 1 }

### Cuerpo JSON inválido -> 400
POST {{host}}/programaciones
Authorization: Bearer {{token}}
Content-Type: application/json

{ "conductor_id":

### Reprogramar todos los campos (PUT) -> 200
PUT {{host}}/programaciones/{{nuevaProgramacion}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "conductor_id": 1,
  "vehiculo_id": 1,
  "ruta_id": 2,
  "fecha_salida": "{{reprograma}}",
  "hora_salida": "07:30:00",
  "fecha_estimada_llegada": "{{llegadaReprograma}}",
  "observaciones": "Reprogramado por mantenimiento"
}

### Reprogramar solo observaciones (PATCH) -> 200
PATCH {{host}}/programaciones/{{nuevaProgramacion}}
Authorization: Bearer {{token}}
Content-Type: application/json

{ "observaciones": "Sin novedades" }

### Cancelar (solo desde programado/retrasado) -> 200
PATCH {{host}}/programaciones/{{nuevaProgramacion}}
Authorization: Bearer {{token}}
Content-Type: application/json

{ "estado": "cancelado" }

### Editar un viaje cancelado -> 409
PATCH {{host}}/programaciones/{{nuevaProgramacion}}
Authorization: Bearer {{token}}
Content-Type: application/json

{ "observaciones": "Otra vez" }

### Editar un viaje en_transito -> 409
PATCH {{host}}/programaciones/2
Authorization: Bearer {{token}}
Content-Type: application/json

{ "estado": "cancelado" }

### Estado fuera del ENUM -> 422
PATCH {{host}}/programaciones/1
Authorization: Bearer {{token}}
Content-Type: application/json

{ "estado": "desconocido" }

### Viajes cancelados -> 200
GET {{host}}/programaciones?estado=cancelado
Authorization: Bearer {{token}}

### Sin token -> 401
GET {{host}}/programaciones
